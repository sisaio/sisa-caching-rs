#!/bin/sh
# Checks the name of each branch pushed, with check-branch next to this file. Git runs it on each
# push once a clone sets `git config core.hooksPath .githooks`, and gives it one line per ref:
# <local ref> <local sha> <remote ref> <remote sha>. Tags and deletions pass.
#
# The same file in every sisaio repository.
set -eu

status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  # A deletion pushes the all-zero id.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  "$(dirname "$0")/check-branch" "${remote_ref#refs/heads/}" || status=1
done
exit "$status"
